# ============================================================
# AI Video Engine - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Claude AI API Key (Required for script generation)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# WaveSpeed API Key for voiceovers (Required)
# Get yours at https://wavespeed.ai
WAVESPEED_API_KEY=YOUR_WAVESPEED_KEY_HERE

# OpenAI API Key for TTS fallback (Optional)
OPENAI_API_KEY=

# Groq API Key for fast LLM inference (Optional)
GROQ_API_KEY=

# Pexels API Key for stock footage (Required)
PEXELS_API_KEY=YOUR_PEXELS_KEY_HERE

# Public URL - Set to your VPS IP or domain when deploying
# Examples:
#   Local:  http://localhost:4000
#   VPS:    http://72.60.225.27:4000
#   Domain: https://video.yourdomain.com
PUBLIC_URL=http://localhost:4000
